# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 커밋되지 않습니다)
#
#   cp .env.example .env.local
#
# tools/queue.mjs 가 이 값을 읽습니다.

# Supabase 대시보드 > Project Settings > API > Project URL
SUPABASE_URL=https://dvharpjpemxpbrhhlolx.supabase.co

# 대시보드 > Project Settings > API Keys > service_role
# ⚠️ RLS 를 전부 무시하는 마스터 키입니다. 앱 코드나 브라우저에 절대 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# /api/publish 를 부를 때 쓰는 비밀값. 아래 명령으로 만드세요.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 같은 값을 Vercel 환경변수와 GitHub Actions 시크릿에도 넣어야 합니다.
CRON_SECRET=
