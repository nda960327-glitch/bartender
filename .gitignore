node_modules/
.vercel/
.DS_Store
Thumbs.db
*.log

# 환경변수 — service_role 키가 들어갑니다. 유출되면 DB 전체가 열립니다. 절대 커밋 금지.
.env
.env.*
!.env.example

# 캐릭터 시안 등 작업용 임시 파일 (_ 로 시작)
_*

# 안드로이드 서명키 — 유출되면 앱 업데이트 권한을 뺏깁니다. 절대 커밋 금지.
*.jks
*.keystore
android.keystore
twa-manifest.json

# 작업 중 생기는 임시 파일
_*.txt
_*.js
_*.html

# 에디터/도구 설정
.claude/

# api/ 안의 _ 파일은 Vercel 이 함수로 노출하지 않는 공용 모듈입니다. 커밋해야 배포가 돼요.
!api/_*.js

# 시연 영상 (용량이 커서 저장소에는 올리지 않아요 — tools/demo-video 로 다시 만들 수 있어요)
docs/video/
tools/demo-video/node_modules/
tools/demo-video/out/

# 스토어 자료 — 그림과 글은 커밋하고, 합성 전 원본과 라이브러리만 빼요
tools/store-assets/node_modules/
store/.raw/

# 결제경로 PPT 결과물 — 심사 계정 비밀번호와 화면 캡처가 들어가요. 도구(tools/payment-path)만 커밋해요.
store/결제경로/
tools/payment-path/node_modules/
